# ── Copy to .env and fill in. The api refuses to boot if any of these is invalid. ──

# Runtime
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://nexahire:nexahire@localhost:5432/nexahire?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# AI gateway (server-side ONLY — never ships to the browser bundle)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8

# ── web (apps/web) — only VITE_ vars reach the browser; never put a secret here ──
VITE_API_URL=http://localhost:3001
